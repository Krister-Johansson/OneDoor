{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": "//",
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    },
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useImportType": "off",
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "**/../**/web",
                  "**/../**/web/**",
                  "/**/web",
                  "/**/web/**",
                  "web",
                  "web/**",
                  "onedoor-web",
                  "onedoor-web/**"
                ],
                "message": "server must not import from web. The only contract is server/schema.gql."
              }
            ]
          }
        }
      }
    }
  }
}
