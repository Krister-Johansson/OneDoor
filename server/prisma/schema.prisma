// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Tables and columns use snake_case in the database, mapped with @@map and @map.

/// A person who owns connections. The proof of concept has one user, `me`,
/// created by the seed (specs/connections.md, REQ-CONN-001).
model User {
  id          String       @id @default(uuid(7)) @db.Uuid
  name        String       @unique
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  connections Connection[]
  tools       Tool[]

  @@map("user")
}

/// How OneDoor authenticates to an MCP server (REQ-CONN-040).
enum AuthType {
  NONE
  API_KEY
  OAUTH_DCR
  OAUTH_MANUAL

  @@map("auth_type")
}

/// A pre-installed server that any user can switch on (REQ-CONN-010). Its
/// auth options say how to connect; the seed creates and updates entries.
model CatalogEntry {
  id          String              @id @default(uuid(7)) @db.Uuid
  /// Stable identifier for seeds and config, such as `github`.
  key         String              @unique
  displayName String              @unique @map("display_name") @db.Citext
  description String              @default("")
  /// REQ-CONN-070. Null until the icon is fetched; the letter icon applies then.
  iconId      String?             @map("icon_id") @db.Uuid
  icon        Icon?               @relation(fields: [iconId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  authOptions CatalogAuthOption[]
  connections Connection[]

  @@map("catalog_entry")
}

/// One way to connect to a catalog entry: an auth type with its URL and, for
/// API_KEY, the header settings (REQ-CONN-010). OAuth client details for an
/// OAUTH_MANUAL option come from server config.
model CatalogAuthOption {
  id             String       @id @default(uuid(7)) @db.Uuid
  catalogEntryId String       @map("catalog_entry_id") @db.Uuid
  catalogEntry   CatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  authType       AuthType     @map("auth_type")
  url            String
  /// Only for API_KEY.
  headerName     String?      @map("header_name")
  /// Only for API_KEY. May be empty.
  headerPrefix   String?      @map("header_prefix")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  connections    Connection[]

  @@unique([catalogEntryId, authType])
  /// Target of the connection's composite foreign key, so a connection's
  /// option always belongs to its entry.
  @@unique([catalogEntryId, id])
  @@map("catalog_auth_option")
}

/// A user's link to one MCP server: either based on a catalog entry, or a
/// custom server. A catalog-based connection takes its display name,
/// description, URL, auth type and header settings from the entry, so those
/// columns are null on it; a check constraint in the migration enforces this.
model Connection {
  id                          String             @id @default(uuid(7)) @db.Uuid
  ownerId                     String             @map("owner_id") @db.Uuid
  owner                       User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  catalogEntryId              String?            @map("catalog_entry_id") @db.Uuid
  catalogEntry                CatalogEntry?      @relation(fields: [catalogEntryId], references: [id], onDelete: Restrict)
  /// The auth option chosen when the entry was switched on (REQ-CONN-012).
  catalogAuthOptionId         String?            @map("catalog_auth_option_id") @db.Uuid
  catalogAuthOption           CatalogAuthOption? @relation(fields: [catalogEntryId, catalogAuthOptionId], references: [catalogEntryId, id], onDelete: Restrict)
  /// Unique per owner, ignoring case (citext). Null on catalog-based connections.
  displayName                 String?            @map("display_name") @db.Citext
  description                 String?
  url                         String?
  authType                    AuthType?          @map("auth_type")
  /// Only for API_KEY.
  headerName                  String?            @map("header_name")
  /// Only for API_KEY. May be empty.
  headerPrefix                String?            @map("header_prefix")
  /// The API key, encrypted by SecretStore with the context
  /// `connection:<id>:api_key` (REQ-CONN-041). For API_KEY connections,
  /// custom or catalog-based.
  apiKeyCiphertext            String?            @map("api_key_ciphertext")
  apiKeyKeyId                 String?            @map("api_key_key_id")
  /// Only for custom OAUTH_MANUAL connections. Not a secret.
  oauthClientId               String?            @map("oauth_client_id")
  /// Encrypted like the API key, with the context `connection:<id>:oauth_client_secret`.
  oauthClientSecretCiphertext String?            @map("oauth_client_secret_ciphertext")
  oauthClientSecretKeyId      String?            @map("oauth_client_secret_key_id")
  enabled                     Boolean            @default(true)
  /// REQ-CONN-070, custom connections only; catalog-based ones use the entry's icon.
  iconId                      String?            @map("icon_id") @db.Uuid
  icon                        Icon?              @relation(fields: [iconId], references: [id], onDelete: SetNull)
  createdAt                   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tools                       Tool[]

  /// The target of Tool's (connection_id, owner_id) foreign key, so a tool
  /// always has its connection's owner.
  @@unique([id, ownerId])
  @@unique([ownerId, displayName])
  @@unique([ownerId, catalogEntryId])
  @@index([catalogEntryId])
  @@map("connection")
}

/// The bytes of a server icon, fetched once and served from OneDoor's own
/// origin (REQ-CONN-071). Rows with the same bytes are shared.
model Icon {
  id             String         @id @default(uuid(7)) @db.Uuid
  /// One of image/png, image/jpeg, image/webp, image/gif,
  /// image/vnd.microsoft.icon or image/svg+xml, read from the bytes.
  contentType    String         @map("content_type")
  bytes          Bytes
  /// SHA-256 of the bytes, hex.
  sha256         String         @unique
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  connections    Connection[]
  catalogEntries CatalogEntry[]

  @@map("icon")
}

/// A tool of a connection's upstream server, as the last tool sync listed it
/// (T18). A failed sync and a disabled connection keep the stored tools;
/// removing the connection deletes them (REQ-CONN-052).
model Tool {
  id           String     @id @default(uuid(7)) @db.Uuid
  /// Always the connection's owner: the connection relation uses both columns.
  ownerId      String     @map("owner_id") @db.Uuid
  owner        User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  connectionId String     @map("connection_id") @db.Uuid
  connection   Connection @relation(fields: [connectionId, ownerId], references: [id, ownerId], onDelete: Cascade)
  /// The name the upstream server uses. Unique per connection, so a tool
  /// keeps its id across syncs.
  name         String
  title        String?
  description  String     @default("")
  inputSchema  Json       @map("input_schema")
  outputSchema Json?      @map("output_schema")
  /// MCP tool annotations. Untrusted hints from the server: shown as labels,
  /// never enforced.
  annotations  Json?
  /// SHA-256 of the canonical JSON of name, title, description, the schemas
  /// and the annotations. A sync rewrites a tool only when this changes.
  contentHash  String     @map("content_hash")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([connectionId, name])
  @@index([ownerId])
  @@map("tool")
}
