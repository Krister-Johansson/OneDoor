# Copy to .env and fill in. Never commit .env.

# app: address the HTTP server listens on.
# Keep 127.0.0.1 while the MCP endpoint has no caller auth.
HOST=127.0.0.1
PORT=3000

# database: PostgreSQL connection for Prisma, postgresql://USER:PASSWORD@HOST:PORT/DB.
# The password is POSTGRES_PASSWORD from the root .env.
DATABASE_URL=

# redis: events, cache and job queue. A URL with a password is a secret.
REDIS_URL=redis://127.0.0.1:6379

# crypto: the key SecretStore encrypts stored secrets with.
# SECRET_STORE_KEY is a secret: 32 random bytes in base64, from `openssl rand -base64 32`.
# Changing it makes every stored secret unreadable.
SECRET_STORE=aes-256-gcm
SECRET_STORE_KEY_ID=dev-1
SECRET_STORE_KEY=

# events: which EventBus to use. Redis comes from REDIS_URL.
EVENT_BUS=redis

# icons: fetch server icons (REQ-CONN-070). Set false to keep the server offline.
ICON_FETCHING=true

# upstreams: keep clients connected to enabled upstream MCP servers. Set false to keep the server offline.
UPSTREAM_CONNECTING=true
# Where authorization servers send the browser back after OAuth (T21).
OAUTH_REDIRECT_URL=http://localhost:3001/oauth/callback
