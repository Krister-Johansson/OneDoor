# Copy to .env and fill in. Never commit .env.

# app: address the HTTP server listens on.
# Keep 127.0.0.1 while the MCP endpoint has no caller auth.
HOST=127.0.0.1
PORT=3000

# database: PostgreSQL connection for Prisma, postgresql://USER:PASSWORD@HOST:PORT/DB.
# The password is POSTGRES_PASSWORD from the root .env.
DATABASE_URL=
