# Copy to .env and adjust. Never commit .env.

# The OneDoor server: server-side rendering calls it directly, and the Vite dev
# server forwards /graphql and /icons to it.
API_URL=http://127.0.0.1:3000

# The GraphQL subscription socket on the OneDoor server, read when the app is
# built. The browser connects to it directly.
VITE_GRAPHQL_WS_URL=ws://127.0.0.1:3000/graphql
