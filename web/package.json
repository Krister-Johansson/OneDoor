{
  "name": "onedoor-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3001",
    "generate-routes": "vite build",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "biome check --error-on-warnings .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "verify": "pnpm lint && pnpm generate-routes && pnpm check-routes && pnpm typecheck && pnpm test",
    "check-routes": "git diff --exit-code -- src/routeTree.gen.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
